rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User Rules
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && 
        incoming().keys().hasAll(['email', 'displayName', 'trialStartDate', 'generationsCount', 'importsCount', 'isPremium']) &&
        incoming().email is string &&
        incoming().generationsCount == 0 &&
        incoming().importsCount == 0 &&
        incoming().isPremium == false;
      allow update: if isOwner(userId) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'generationsCount', 'importsCount', 'isPremium']);
    }

    // Design Rules
    match /designs/{designId} {
      function isValidDesign(data) {
        return data.ownerId is string &&
               data.ownerId.size() <= 128 &&
               data.status in ['draft', 'analyzing', 'generating', 'completed'] &&
               data.createdAt is string;
      }

      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      
      allow create: if isSignedIn() && 
        incoming().ownerId == request.auth.uid &&
        isValidDesign(incoming());
        
      allow update: if isSignedIn() && 
        existing().ownerId == request.auth.uid &&
        incoming().ownerId == request.auth.uid &&
        isValidDesign(incoming()) &&
        (
          // Allow updating status, analysis, prompt, generatedCode
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'analysis', 'prompt', 'generatedImageUrl', 'name'])
        );

      allow delete: if isSignedIn() && existing().ownerId == request.auth.uid;
    }
  }
}
